{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: VidrieriaPresupuestos.Web",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/VidrieriaPresupuestos.Web/bin/Debug/net10.0/VidrieriaPresupuestos.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/VidrieriaPresupuestos.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        }
    ]
}