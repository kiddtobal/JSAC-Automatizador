## .gitignore para proyectos .NET / Blazor

# Carpetas de compilación
[Bb]in/
[Oo]bj/
[Oo]ut/

# Archivos de Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.user
*.suo

# Resultados de build
*.dll
*.exe
*.pdb

# Base de datos SQLite (datos locales, no se versionan)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Configuración con datos sensibles (connection strings reales, credenciales)
appsettings.Production.json
appsettings.*.Local.json
secrets.json

# Logs
*.log
logs/

# Archivos de usuario/máquina específicos de Rider/ReSharper
.idea/
*.DotSettings.user

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Publicación
[Pp]ublish/
*.pubxml
*.pubxml.user

# Archivos temporales del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Certificados de desarrollo HTTPS (no se comparten entre máquinas)
*.pfx