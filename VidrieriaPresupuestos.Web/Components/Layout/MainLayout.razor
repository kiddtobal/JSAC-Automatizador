@inherits LayoutComponentBase
@inject VidrieriaContext Context

<MudAppBar Fixed="true" Elevation="2">
    <MudStack Spacing="0" Justify="Justify.Center">
        <MudText Typo="Typo.h5" Color="Color.Inherit" Style="line-height:1.1;">Rimalto</MudText>
        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.75); line-height:1;">Sistema de Presupuestos</MudText>
    </MudStack>
</MudAppBar>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @if (mostrarRecordatorio)
        {
            <MudAlert Severity="Severity.Info" Square="true" ShowCloseIcon="true" CloseIconClicked="CerrarRecordatorio">
                Recordatorio: revise el stock de sus productos y confirme que los precios estén actualizados.
            </MudAlert>
        }

        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string ClaveRecordatorioStock = "RevisionStockPrecios";

    private bool mostrarRecordatorio;
    private RecordatorioSistema? registroRecordatorio;

    protected override async Task OnInitializedAsync()
    {
        registroRecordatorio = await Context.RecordatoriosSistema
            .FirstOrDefaultAsync(r => r.Clave == ClaveRecordatorioStock);

        mostrarRecordatorio = registroRecordatorio is null
            || registroRecordatorio.UltimaVezMostrado is null
            || (DateTime.Today - registroRecordatorio.UltimaVezMostrado.Value.Date).TotalDays >= 15;
    }

    private async Task CerrarRecordatorio()
    {
        mostrarRecordatorio = false;

        if (registroRecordatorio is null)
        {
            registroRecordatorio = new RecordatorioSistema
            {
                Clave = ClaveRecordatorioStock,
                UltimaVezMostrado = DateTime.Today
            };
            Context.RecordatoriosSistema.Add(registroRecordatorio);
        }
        else
        {
            registroRecordatorio.UltimaVezMostrado = DateTime.Today;
        }

        await Context.SaveChangesAsync();
    }
}
