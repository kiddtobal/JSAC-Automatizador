@page "/cotizadores"
@rendermode InteractiveServer
@inject VidrieriaContext Context
@using Microsoft.EntityFrameworkCore


<PageTitle>Rimalto - Cotizadores</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Cotizadores</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="MostrarFormulario">
            Nuevo Cotizador
        </MudButton>
    </MudStack>

    @if (mostrarFormulario)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudForm @ref="form" Model="nuevoCotizador" @onsubmit="GuardarCotizador">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="nuevoCotizador.Nombre"
                                      Label="Nombre"
                                      Required="true"
                                      RequiredError="El nombre es obligatorio"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="nuevoCotizador.Cargo"
                                      Label="Cargo" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="nuevoCotizador.Celular"
                                      Label="Celular"
                                      Required="true"
                                      RequiredError="El celular es obligatorio"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="nuevoCotizador.Email"
                                      Label="Email"
                                      Required="true"
                                      RequiredError="El email es obligatorio"
                                      Immediate="true" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Class="mt-4">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                        Guardar
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="CancelarFormulario">
                        Cancelar
                    </MudButton>
                </MudStack>
            </MudForm>
        </MudPaper>
    }

    <MudTable Items="cotizadores" Dense="true" Hover="true" Striped="true" Loading="cargando">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Cargo</MudTh>
            <MudTh>Celular</MudTh>
            <MudTh>Email</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Cargo">@context.Cargo</MudTd>
            <MudTd DataLabel="Celular">@context.Celular</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private List<Cotizador> cotizadores = new();
    private Cotizador nuevoCotizador = new();
    private MudForm? form;
    private bool mostrarFormulario;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarCotizadores();
    }

    private async Task CargarCotizadores()
    {
        cargando = true;
        cotizadores = await Context.Cotizadores.OrderBy(c => c.Nombre).ToListAsync();
        cargando = false;
    }

    private void MostrarFormulario()
    {
        nuevoCotizador = new Cotizador();
        mostrarFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        nuevoCotizador = new Cotizador();
    }

    private async Task GuardarCotizador()
    {
        if (string.IsNullOrWhiteSpace(nuevoCotizador.Nombre)
            || string.IsNullOrWhiteSpace(nuevoCotizador.Celular)
            || string.IsNullOrWhiteSpace(nuevoCotizador.Email))
        {
            return;
        }

        Context.Cotizadores.Add(nuevoCotizador);
        await Context.SaveChangesAsync();

        mostrarFormulario = false;
        nuevoCotizador = new Cotizador();
        await CargarCotizadores();
    }
}
