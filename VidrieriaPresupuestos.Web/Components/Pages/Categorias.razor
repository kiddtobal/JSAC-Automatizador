@page "/categorias"
@rendermode InteractiveServer
@inject VidrieriaContext Context
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Rimalto - Categorías</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Categorías</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AbrirDialogoNuevaCategoria(null))">
            Nueva Categoría
        </MudButton>
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Outlined="true" Class="pa-2">
                @if (cargando)
                {
                    <MudProgressCircular Indeterminate="true" Class="ma-4" />
                }
                else if (arbolCategorias.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="pa-2">No hay categorías creadas todavía.</MudText>
                }
                else
                {
                    <MudTreeView T="Categoria" Items="arbolCategorias" @bind-SelectedValue="categoriaSeleccionada" @bind-SelectedValue:after="OnCategoriaSeleccionada" Hover="true">
                        <ItemTemplate>
                            <MudTreeViewItem T="Categoria" Value="@context.Value" Items="@context.Children" Text="@context.Text" />
                        </ItemTemplate>
                    </MudTreeView>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            @if (categoriaSeleccionada is null)
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">Seleccione una categoría del árbol para ver su detalle.</MudText>
            }
            else
            {
                <MudPaper Outlined="true" Class="pa-4">
                    <MudTextField @bind-Value="nombreEdicion" Label="Nombre" Immediate="true" Required="true" RequiredError="El nombre es obligatorio" />
                    <MudStack Row="true" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarNombreCategoria">Guardar Cambios</MudButton>
                        @if (categoriaSeleccionada.CategoriaPadreId is null)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AbrirDialogoNuevaCategoria(categoriaSeleccionada.Id))">
                                Nueva Subcategoría
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="EliminarCategoria">Eliminar Categoría</MudButton>
                    </MudStack>

                    <MudDivider Class="my-4" />

                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                        <MudText Typo="Typo.h6">Productos de esta categoría</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="MostrarFormProducto">
                            Agregar Producto
                        </MudButton>
                    </MudStack>

                    @if (mostrarFormProducto)
                    {
                        <MudPaper Outlined="true" Class="pa-3 mb-3">
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="nuevoProductoNombre" Label="Nombre" Immediate="true" Required="true" RequiredError="Obligatorio" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="nuevoProductoUnidad" Label="Unidad (ej: u., m2, ml)" Immediate="true" Required="true" RequiredError="Obligatorio" />
                                </MudItem>
                                <MudItem xs="12" sm="2" Class="d-flex align-center">
                                    <MudCheckBox T="bool" @bind-Value="nuevoProductoExterno" Label="Externo (+20%)" />
                                </MudItem>
                            </MudGrid>

                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.subtitle2" Class="mb-2">Precios de Referencia</MudText>

                            @if (nuevosPreciosProducto.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Todavía no agregaste ningún precio. Se necesita al menos uno para guardar.</MudText>
                            }
                            else
                            {
                                @foreach (var precio in nuevosPreciosProducto)
                                {
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                                        <MudText Typo="Typo.body2">@precio.Proveedor — @precio.Precio.ToString("C")@(string.IsNullOrWhiteSpace(precio.UrlReferencia) ? "" : " (con link)")</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => nuevosPreciosProducto.Remove(precio))" />
                                    </MudStack>
                                }
                            }

                            <MudGrid Class="mt-1">
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="nuevoPrecioProveedor" Label="Proveedor" Immediate="true" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudNumericField T="decimal" @bind-Value="nuevoPrecioValor" Label="Precio" Immediate="true" Min="0" Format="F0" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudTextField @bind-Value="nuevoPrecioUrl" Label="URL (opcional)" Immediate="true" />
                                </MudItem>
                                <MudItem xs="12" sm="2">
                                    <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="AgregarPrecioAlNuevoProducto">+ Precio</MudButton>
                                </MudItem>
                            </MudGrid>

                            <MudStack Row="true" Class="mt-3">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarProducto">Guardar</MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="CancelarFormProducto">Cancelar</MudButton>
                            </MudStack>
                        </MudPaper>
                    }

                    @if (productosCategoria.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Esta categoría no tiene productos cargados.</MudText>
                    }
                    else
                    {
                        @foreach (var producto in productosCategoria)
                        {
                            @if (EstaProductoExpandido(producto))
                            {
                                <MudPaper Outlined="true" Class="pa-3 mb-2">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="producto.Nombre" Label="Nombre" Immediate="true" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="producto.Unidad" Label="Unidad" Immediate="true" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3" Class="d-flex align-center">
                                            <MudCheckBox T="bool" Value="@(producto.Origen == OrigenItem.MaterialExterno)" ValueChanged="@((bool v) => OnExternoProductoChanged(producto, v))" Label="Externo (+20%)" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3" Class="d-flex align-center">
                                            <MudCheckBox T="bool" @bind-Value="producto.Activo" Label="Activo" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudStack Row="true" Class="mt-2 mb-3">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => GuardarCambiosProducto(producto))">Guardar Cambios</MudButton>
                                        <MudButton Variant="Variant.Text" OnClick="@(() => AlternarProductoExpandido(producto))">Listo</MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => EliminarProducto(producto))">Eliminar Producto</MudButton>
                                    </MudStack>

                                    <MudDivider Class="mb-3" />

                                    <MudText Typo="Typo.subtitle2" Class="mb-2">Precios de Referencia</MudText>

                                    @if (producto.PreciosReferencia.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Sin precios cargados.</MudText>
                                    }
                                    else
                                    {
                                        @foreach (var precio in producto.PreciosReferencia.OrderBy(p => p.Precio))
                                        {
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                                                <span>
                                                    <MudText Typo="Typo.body2" Style="display:inline">@precio.Proveedor — @precio.Precio.ToString("C")</MudText>
                                                    @if (!string.IsNullOrWhiteSpace(precio.UrlReferencia))
                                                    {
                                                        <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small" Href="@precio.UrlReferencia" Target="_blank" />
                                                    }
                                                </span>
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => EliminarPrecioExistente(producto, precio))" />
                                            </MudStack>
                                        }
                                    }

                                    @if (productoAgregandoPrecioId == producto.Id)
                                    {
                                        <MudGrid Class="mt-1">
                                            <MudItem xs="12" sm="4">
                                                <MudTextField @bind-Value="nuevoPrecioExistenteProveedor" Label="Proveedor" Immediate="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="3">
                                                <MudNumericField T="decimal" @bind-Value="nuevoPrecioExistenteValor" Label="Precio" Immediate="true" Min="0" Format="F0" />
                                            </MudItem>
                                            <MudItem xs="12" sm="3">
                                                <MudTextField @bind-Value="nuevoPrecioExistenteUrl" Label="URL (opcional)" Immediate="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="2">
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="@(() => GuardarPrecioExistente(producto))">Guardar</MudButton>
                                            </MudItem>
                                        </MudGrid>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => MostrarFormPrecioExistente(producto))">
                                            Agregar Precio
                                        </MudButton>
                                    }
                                </MudPaper>
                            }
                            else
                            {
                                <MudPaper Outlined="true" Class="pa-3 mb-2" Style="@(producto.Activo ? null : "opacity:0.6;")">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <span>
                                            @producto.Nombre
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:inline-block; margin-left:4px;">
                                                (@producto.Unidad@(producto.Origen == OrigenItem.MaterialExterno ? " · Externo" : "")@(producto.Activo ? "" : " · Inactivo") · @TextoResumenPrecios(producto))
                                            </MudText>
                                        </span>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => AlternarProductoExpandido(producto))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => EliminarProducto(producto))" />
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        }
                    }
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private List<Categoria> categorias = new();
    private List<TreeItemData<Categoria>> arbolCategorias = new();
    private bool cargando = true;

    private Categoria? categoriaSeleccionada;
    private string? nombreEdicion;

    private List<ProductoCatalogo> productosCategoria = new();
    private HashSet<int> productosExpandido = new();

    private bool mostrarFormProducto;
    private string? nuevoProductoNombre;
    private string? nuevoProductoUnidad;
    private bool nuevoProductoExterno;
    private List<ProductoPrecioReferencia> nuevosPreciosProducto = new();

    private string? nuevoPrecioProveedor;
    private decimal nuevoPrecioValor;
    private string? nuevoPrecioUrl;

    private int? productoAgregandoPrecioId;
    private string? nuevoPrecioExistenteProveedor;
    private decimal nuevoPrecioExistenteValor;
    private string? nuevoPrecioExistenteUrl;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private async Task CargarCategorias()
    {
        cargando = true;
        categorias = await Context.Categorias.OrderBy(c => c.Nombre).ToListAsync();
        arbolCategorias = ConstruirArbol();
        cargando = false;
    }

    private List<TreeItemData<Categoria>> ConstruirArbol() =>
        categorias.Where(c => c.CategoriaPadreId is null)
                  .OrderBy(c => c.Nombre)
                  .Select(ConstruirNodo)
                  .ToList();

    private TreeItemData<Categoria> ConstruirNodo(Categoria categoria)
    {
        var hijos = categorias.Where(c => c.CategoriaPadreId == categoria.Id)
                               .OrderBy(c => c.Nombre)
                               .Select(ConstruirNodo)
                               .ToList();

        return new TreeItemData<Categoria>
        {
            Value = categoria,
            Text = categoria.Nombre,
            Expandable = hijos.Count > 0,
            Children = hijos.Count > 0 ? hijos : null
        };
    }

    private async Task AbrirDialogoNuevaCategoria(int? categoriaPadreId)
    {
        var titulo = categoriaPadreId is null ? "Nueva Categoría" : "Nueva Subcategoría";
        var dialog = await DialogService.ShowAsync<NuevaCategoriaDialog>(titulo);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled && resultado.Data is string nombre && !string.IsNullOrWhiteSpace(nombre))
        {
            Context.Categorias.Add(new Categoria { Nombre = nombre, CategoriaPadreId = categoriaPadreId });
            await Context.SaveChangesAsync();

            Snackbar.Add(categoriaPadreId is null ? "Categoría creada" : "Subcategoría creada", Severity.Success);
            await CargarCategorias();
        }
    }

    private async Task OnCategoriaSeleccionada()
    {
        nombreEdicion = categoriaSeleccionada?.Nombre;
        mostrarFormProducto = false;
        productosExpandido = new();
        productoAgregandoPrecioId = null;
        productosCategoria = new();

        if (categoriaSeleccionada is not null)
        {
            productosCategoria = await Context.ProductosCatalogo
                .Include(p => p.PreciosReferencia)
                .Where(p => p.CategoriaId == categoriaSeleccionada.Id)
                .OrderBy(p => p.Nombre)
                .ToListAsync();
        }
    }

    private async Task GuardarNombreCategoria()
    {
        if (categoriaSeleccionada is null || string.IsNullOrWhiteSpace(nombreEdicion))
        {
            Snackbar.Add("El nombre no puede estar vacío", Severity.Error);
            return;
        }

        categoriaSeleccionada.Nombre = nombreEdicion;
        await Context.SaveChangesAsync();
        arbolCategorias = ConstruirArbol();

        Snackbar.Add("Categoría actualizada", Severity.Success);
    }

    private async Task EliminarCategoria()
    {
        if (categoriaSeleccionada is null)
        {
            return;
        }

        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Eliminar categoría",
            $"¿Confirma que desea eliminar la categoría '{categoriaSeleccionada.Nombre}'? Esta acción no se puede deshacer.",
            yesText: "Eliminar", cancelText: "Cancelar");

        if (confirmado != true)
        {
            return;
        }

        var tieneSubcategorias = categorias.Any(c => c.CategoriaPadreId == categoriaSeleccionada.Id);
        var tieneProductos = productosCategoria.Count > 0;

        if (tieneSubcategorias || tieneProductos)
        {
            Snackbar.Add("No se puede eliminar: la categoría tiene subcategorías o productos asociados.", Severity.Error);
            return;
        }

        try
        {
            Context.Categorias.Remove(categoriaSeleccionada);
            await Context.SaveChangesAsync();

            Snackbar.Add("Categoría eliminada", Severity.Success);
            categoriaSeleccionada = null;
            nombreEdicion = null;
            productosCategoria = new();
            await CargarCategorias();
        }
        catch (DbUpdateException)
        {
            Context.Entry(categoriaSeleccionada).State = EntityState.Unchanged;
            Snackbar.Add("No se puede eliminar: la categoría tiene subcategorías o productos asociados.", Severity.Error);
        }
        catch (InvalidOperationException)
        {
            Context.Entry(categoriaSeleccionada).State = EntityState.Unchanged;
            Snackbar.Add("No se puede eliminar: la categoría tiene subcategorías o productos asociados.", Severity.Error);
        }
    }

    private bool EstaProductoExpandido(ProductoCatalogo producto) => productosExpandido.Contains(producto.Id);

    private void AlternarProductoExpandido(ProductoCatalogo producto)
    {
        if (!productosExpandido.Add(producto.Id))
        {
            productosExpandido.Remove(producto.Id);
            if (productoAgregandoPrecioId == producto.Id)
            {
                productoAgregandoPrecioId = null;
            }
        }
    }

    private string TextoResumenPrecios(ProductoCatalogo producto)
    {
        if (producto.PreciosReferencia.Count == 0)
        {
            return "Sin precios cargados";
        }

        var minimo = producto.PreciosReferencia.Min(p => p.Precio);
        var cantidad = producto.PreciosReferencia.Count;
        return $"Desde {minimo:C} ({cantidad} precio{(cantidad == 1 ? "" : "s")})";
    }

    private bool UrlValida(string? url) => string.IsNullOrWhiteSpace(url) || Uri.TryCreate(url, UriKind.Absolute, out _);

    private void MostrarFormProducto()
    {
        nuevoProductoNombre = null;
        nuevoProductoUnidad = null;
        nuevoProductoExterno = false;
        nuevosPreciosProducto = new();
        LimpiarMiniFormPrecio();
        mostrarFormProducto = true;
    }

    private void CancelarFormProducto()
    {
        mostrarFormProducto = false;
    }

    private void LimpiarMiniFormPrecio()
    {
        nuevoPrecioProveedor = null;
        nuevoPrecioValor = 0;
        nuevoPrecioUrl = null;
    }

    private void AgregarPrecioAlNuevoProducto()
    {
        if (string.IsNullOrWhiteSpace(nuevoPrecioProveedor))
        {
            Snackbar.Add("El proveedor es obligatorio", Severity.Error);
            return;
        }

        if (nuevoPrecioValor <= 0)
        {
            Snackbar.Add("El precio debe ser mayor a 0", Severity.Error);
            return;
        }

        if (!UrlValida(nuevoPrecioUrl))
        {
            Snackbar.Add("La URL no tiene un formato válido", Severity.Error);
            return;
        }

        nuevosPreciosProducto.Add(new ProductoPrecioReferencia
        {
            Proveedor = nuevoPrecioProveedor,
            Precio = Math.Round(nuevoPrecioValor, 0, MidpointRounding.AwayFromZero),
            UrlReferencia = string.IsNullOrWhiteSpace(nuevoPrecioUrl) ? null : nuevoPrecioUrl
        });

        LimpiarMiniFormPrecio();
    }

    private async Task GuardarProducto()
    {
        if (categoriaSeleccionada is null || string.IsNullOrWhiteSpace(nuevoProductoNombre) || string.IsNullOrWhiteSpace(nuevoProductoUnidad))
        {
            Snackbar.Add("Nombre y Unidad son obligatorios", Severity.Error);
            return;
        }

        if (nuevosPreciosProducto.Count == 0)
        {
            Snackbar.Add("Debe agregar al menos un precio de referencia antes de guardar", Severity.Error);
            return;
        }

        var producto = new ProductoCatalogo
        {
            CategoriaId = categoriaSeleccionada.Id,
            Nombre = nuevoProductoNombre,
            Unidad = nuevoProductoUnidad,
            Origen = nuevoProductoExterno ? OrigenItem.MaterialExterno : OrigenItem.Inventario,
            PorcentajeComision = nuevoProductoExterno ? 20 : 0,
            Activo = true,
            PreciosReferencia = nuevosPreciosProducto
        };

        Context.ProductosCatalogo.Add(producto);
        await Context.SaveChangesAsync();

        productosCategoria.Add(producto);
        productosCategoria = productosCategoria.OrderBy(p => p.Nombre).ToList();
        mostrarFormProducto = false;

        Snackbar.Add("Producto agregado", Severity.Success);
    }

    private void OnExternoProductoChanged(ProductoCatalogo producto, bool externo)
    {
        producto.Origen = externo ? OrigenItem.MaterialExterno : OrigenItem.Inventario;
        producto.PorcentajeComision = externo ? 20 : 0;
    }

    private async Task GuardarCambiosProducto(ProductoCatalogo producto)
    {
        if (string.IsNullOrWhiteSpace(producto.Nombre) || string.IsNullOrWhiteSpace(producto.Unidad))
        {
            Snackbar.Add("Nombre y Unidad son obligatorios", Severity.Error);
            return;
        }

        await Context.SaveChangesAsync();
        Snackbar.Add("Producto actualizado", Severity.Success);
    }

    private void MostrarFormPrecioExistente(ProductoCatalogo producto)
    {
        productoAgregandoPrecioId = producto.Id;
        nuevoPrecioExistenteProveedor = null;
        nuevoPrecioExistenteValor = 0;
        nuevoPrecioExistenteUrl = null;
    }

    private async Task GuardarPrecioExistente(ProductoCatalogo producto)
    {
        if (string.IsNullOrWhiteSpace(nuevoPrecioExistenteProveedor))
        {
            Snackbar.Add("El proveedor es obligatorio", Severity.Error);
            return;
        }

        if (nuevoPrecioExistenteValor <= 0)
        {
            Snackbar.Add("El precio debe ser mayor a 0", Severity.Error);
            return;
        }

        if (!UrlValida(nuevoPrecioExistenteUrl))
        {
            Snackbar.Add("La URL no tiene un formato válido", Severity.Error);
            return;
        }

        var precio = new ProductoPrecioReferencia
        {
            ProductoCatalogoId = producto.Id,
            Proveedor = nuevoPrecioExistenteProveedor,
            Precio = Math.Round(nuevoPrecioExistenteValor, 0, MidpointRounding.AwayFromZero),
            UrlReferencia = string.IsNullOrWhiteSpace(nuevoPrecioExistenteUrl) ? null : nuevoPrecioExistenteUrl
        };

        Context.PreciosReferencia.Add(precio);
        await Context.SaveChangesAsync();

        producto.PreciosReferencia.Add(precio);
        productoAgregandoPrecioId = null;

        Snackbar.Add("Precio agregado", Severity.Success);
    }

    private async Task EliminarPrecioExistente(ProductoCatalogo producto, ProductoPrecioReferencia precio)
    {
        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Eliminar precio de referencia",
            $"¿Confirma que desea eliminar el precio de '{precio.Proveedor}' ({precio.Precio:C})? Esta acción no se puede deshacer.",
            yesText: "Eliminar", cancelText: "Cancelar");

        if (confirmado != true)
        {
            return;
        }

        Context.PreciosReferencia.Remove(precio);
        await Context.SaveChangesAsync();

        producto.PreciosReferencia.Remove(precio);
        Snackbar.Add("Precio eliminado", Severity.Success);
    }

    private async Task EliminarProducto(ProductoCatalogo producto)
    {
        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Eliminar producto",
            $"¿Confirma que desea eliminar el producto '{producto.Nombre}'? Esta acción no se puede deshacer.",
            yesText: "Eliminar", cancelText: "Cancelar");

        if (confirmado != true)
        {
            return;
        }

        try
        {
            Context.ProductosCatalogo.Remove(producto);
            await Context.SaveChangesAsync();

            productosCategoria.Remove(producto);
            productosExpandido.Remove(producto.Id);
            Snackbar.Add("Producto eliminado", Severity.Success);
        }
        catch (DbUpdateException)
        {
            Context.Entry(producto).State = EntityState.Unchanged;
            Snackbar.Add("No se pudo eliminar el producto.", Severity.Error);
        }
        catch (InvalidOperationException)
        {
            Context.Entry(producto).State = EntityState.Unchanged;
            Snackbar.Add("No se pudo eliminar el producto.", Severity.Error);
        }
    }
}
